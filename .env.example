# ─────────────────────────────────────────────────────────────────────────────
# hood-traders configuration. Copy to `.env` and edit. NOTHING here is required
# to run in paper mode — `docker compose up` and `npm run fleet` both work with
# zero config against live mainnet data.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────
# Which Robinhood Chain to observe/trade on. mainnet = 4663, testnet = 46630.
HOOD_NETWORK=mainnet
# Optional paid RPC (Alchemy recommended for live trading). Falls back to the
# public RPC baked into viem's chain def when unset.
# HOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
# Optional wss:// endpoint — primary tier for the discovery watcher (a true
# eth_subscribe push, vs. HOOD_RPC_URL's 2s-poll fallback). See
# src/chain/rpc-manager.ts. Falls back through HOOD_RPC_URL, then the public
# RPC, when unset — discovery works with zero config, just less instantly.
# HOOD_WS_RPC_URL=wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Live trading (OFF by default) ────────────────────────────────────────────
# Paper mode is the default and needs none of the below. To trade REAL funds you
# must set ALL THREE of HOOD_TRADERS_LIVE=1, a funded key, AND
# LIVE_ACKNOWLEDGED=YES. Every safeguard below still applies in live mode —
# they are not optional. Even with all three set, src/main.ts's Level 10
# Launch Gate still refuses to start unless the shadow/paper/probe phases
# have real accumulated evidence — see docs/LIVE_TRADING.md.
HOOD_TRADERS_LIVE=0
# Wallet private key for live/testnet execution. Env var ONLY — never in code.
# ROBINHOOD_CHAIN_PRIVATE_KEY=0x...
# Explicit, separate "I understand this risks real money" consent. Must be
# the exact string YES (case-sensitive) — HOOD_TRADERS_LIVE=1 alone is not
# enough. See scripts/start-live.sh / scripts/start-probe.sh.
# LIVE_ACKNOWLEDGED=YES

# Affirm you are NOT a US/CA/UK/CH person before any Stock Token ACQUISITION.
# Stock Tokens are tokenized debt securities and may not be sold to US persons.
# Leaving this false blocks the premium-watch strategy from buying Stock Tokens
# (it stays alerts-only). Selling and displaying data are never gated.
HOOD_STOCK_TOKEN_ELIGIBLE=false

# ── Global risk rails (apply to the whole fleet) ─────────────────────────────
# Hard ceiling on notional the entire fleet may spend per UTC day, in USDG.
FLEET_MAX_DAILY_SPEND_USDG=250
# Dashboard + kill-switch HTTP server port.
DASHBOARD_PORT=4670
# Bind address for the dashboard/kill-switch HTTP server. Defaults to
# loopback-only (127.0.0.1) — do not set this to 0.0.0.0 outside a container
# or other environment where the network boundary is otherwise controlled.
DASHBOARD_HOST=127.0.0.1
# Path to a file whose existence trips the global kill switch.
KILL_FILE=./KILL

# ── Level 10.1: run phase (data separation only — never changes trading logic) ──
# Which validation phase this process is: shadow | paper | probe | live. Scopes
# every SQLite store + shadow-run.json under data/<phase>/ so Shadow and Paper
# can run as two independent, simultaneous processes without sharing a DB.
# Defaults to "paper" in paper mode and "live" in live mode if unset — only set
# this explicitly for "shadow" or "probe" (see scripts/start-shadow.sh /
# start-probe.sh, which already set it for you). See docs/LIVE_TRADING.md.
# HOOD_RUN_PHASE=paper
# The Launch Gate rejects shadow/paper/probe evidence recorded under a
# different git commit/config/strategy version by default (Level 10.1's build
# fingerprint). Comma-separated list of prior commit SHAs you've personally
# reviewed and vouch for as NOT affecting trading logic (e.g. a docs-only
# commit) — an explicit, narrow escape hatch, not a general bypass. Leave
# unset unless you have a specific reviewed SHA to allow.
# LAUNCH_GATE_ALLOWED_PRIOR_SHAS=

# ── Per-agent risk rails (defaults; overridable per agent in fleet config) ───
AGENT_MAX_POSITION_USDG=50
AGENT_MAX_DAILY_SPEND_USDG=100
AGENT_MAX_SLIPPAGE_BPS=100
AGENT_COOLDOWN_SECONDS=60

# ── llm-strategist (OPTIONAL — the strategy is simply not added to the fleet
# unless BOTH vars below are set). Bring your own key: pick exactly ONE
# provider. Every LLM verdict still passes through the same risk engine as
# every other strategy — an LLM proposes, it never executes directly.
# provider: anthropic | openai | groq | openrouter
HOOD_LLM_PROVIDER=
HOOD_LLM_API_KEY=
# Optional. Falls back to a sane per-provider default when unset (see
# src/framework/llm.ts DEFAULT_MODELS) — set this if that default ever goes
# stale for your provider, or to pick a stronger/cheaper model.
HOOD_LLM_MODEL=
# Minimum LLM-stated confidence (0-1) required to actually place the trade.
HOOD_LLM_MIN_CONFIDENCE=0.6
# Per-call timeout before the judge is treated as failed (skips the candidate).
HOOD_LLM_TIMEOUT_MS=9000

# ── Telegram critical alerts + read-only remote control (OPTIONAL — the bot
# is simply not started unless BOTH vars below are set). See docs/OPERATIONS.md.
# The admin chat is fixed at config-load time — nothing ever learns a new
# admin from an incoming message. Commands: /status, /positions, /pause.
# /resume is permanently disabled by design (use the dashboard or restart the
# process instead). No command can ever trigger a BUY.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
